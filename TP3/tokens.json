[
    {
        "id": "PR",
        "expreg": "[sS][eE][lL][eE][cC][tT]|[lL][iI][mM][iI][tT]|[wW][hH][eE][rR][eE]"
    },
    {
        "id": "C",
        "expreg": "#.*"
    },
    {
        "id": "IDV",
        "expreg": "\\?\\w+"
    },
    {
        "id": "IDL",
        "expreg": "@[a-zA-Z]{2}"
    },
    {
        "id": "STR",
        "expreg": "\".*?\""
    },
    {
        "id": "N",
        "expreg": "\\d+"
    },
    {
        "id": "IDC",
        "expreg": "(?<= |:)(\\w+)"
    },
    {
        "id": "D",
        "expreg": "\\{|\\}|\\."
    },
    {
        "id": "SKIP",
        "expreg": "[ \\t]"
    }
]